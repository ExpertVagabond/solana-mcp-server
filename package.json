{
  "name": "solana-mcp-server",
  "mcpName": "io.github.ExpertVagabond/solana",
  "version": "1.1.1",
  "description": "Solana MCP server for wallet management, transaction handling, and program interactions on Solana blockchain",
  "main": "dist/index.js",
  "bin": {
    "solana-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:smithery": "npx @smithery/cli build",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "dev": "npx @smithery/cli dev",
    "start": "node dist/index.js",
    "test": "node test-simple.js && node test-bin.js",
    "test:jest": "jest",
    "prepare": "npm run build",
    "publish:npm": "npm publish --access public",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "quality": "npm run lint && npm run format:check && npm run type-check && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@solana/web3.js": "3.1.1",
    "bs58": "^5.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "keywords": [
    "mcp",
    "solana",
    "blockchain",
    "wallet",
    "defi",
    "web3",
    "smart-contracts",
    "spl-tokens"
  ],
  "author": "ExpertVagabond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExpertVagabond/solana-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ExpertVagabond/solana-mcp-server/issues"
  },
  "homepage": "https://github.com/ExpertVagabond/solana-mcp-server#readme"
}
